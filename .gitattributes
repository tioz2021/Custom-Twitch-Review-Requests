# Normalize line endings so the repository is identical on every platform.
#
# This matters for this project specifically: multi-line string replacement and
# comment matching once failed because files on disk had CRLF while the patterns
# used LF. Keeping text files as LF in the repository removes that class of bug.

* text=auto eol=lf

# Binary files must never be touched by the newline conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary

# Network dumps and large fixtures stay untouched if they are ever committed.
*.har binary
